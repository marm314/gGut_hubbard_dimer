__pycache__/
*.pyc

# LaTeX build artifacts (code.pdf is kept, tracked in git)
doc/code.aux
doc/code.log
doc/code.out
doc/code.toc
doc/not_impurity.aux
doc/not_impurity.log
doc/not_impurity.out
doc/not_impurity.toc
scan_ed_deltaV/ED_deltaV.aux
scan_ed_deltaV/ED_deltaV.log
scan_ed_deltaV/ED_deltaV.out
scan_ed_deltaV/ED_deltaV.toc

# Run outputs regenerated by the examples (see examples/*/README.md)
examples/*/*.dat
examples/*/A_omega.txt
examples/*/gga_Ng*.out

# Local virtualenvs and reference-code test runs (not tracked)
.venv/
outside_code/

# Transient run logs (the actual results live in each scan's own output.out/lowest_energy.txt)
*.log

# Claude Code session-local runtime state (machine/session-specific, not reproducible elsewhere)
.claude/scheduled_tasks.lock

# graphify regenerable output (the curated graph files themselves stay tracked)
graphify-out/cache/ast/
graphify-out/cache/last_query_stamp
graphify-out/20*/
graphify-out/*.sig

# LaTeX build artifacts and tex backups (doc/)
doc/cederbaum.aux
doc/cederbaum.out
doc/excited_phi_cederbaum.aux
doc/excited_phi_cederbaum.out
doc/results.aux
doc/results.out
doc/results.toc
doc/*.tex.bak
*.orig

# 4-site FCI broadened spectra (regenerate: ~/.venv/bin/python scripts/hubbard4_fci.py, ~10 s)
hubbard4_fci/*/A_loc_U*.dat
hubbard4_fci/*/spectra.npz

# 4-site (g)Gutzwiller per-run folders (inputs, gg.out, A.npz; ~800 MB). Regenerate:
#   scripts/scan_4site_cpp.py --Ng {0,2} --bc obc pbc apbc; scripts/polish_4site_cpp.py --Ng {0,2}
scan_4site_ng*/*/forward/
scan_4site_ng*/*/backward/
scan_4site_ng*/*/polish/
doc/results_4site.aux
doc/results_4site.out
doc/results_4site.toc
